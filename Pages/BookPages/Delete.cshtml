@page
@model Lupas_Miruna_Lab2.Pages.BookPages.DeleteModel

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Book</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Book.Title)</dd>
        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Book.Author.FullName)</dd>
        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Book.Price)</dd>
        <dt class="col-sm-2">Publishing Date</dt>
        <dd class="col-sm-10">@Model.Book.PublishingDate.ToShortDateString()</dd>
        <dt class="col-sm-2">Publisher</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Book.Publisher.PublisherName)</dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Book.ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>